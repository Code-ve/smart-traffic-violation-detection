# ── Model ─────────────────────────────────────────────────────────────────
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50
TRACKER_TYPE=bytetrack

# ── Database ──────────────────────────────────────────────────────────────
# DATABASE_URL=data/traffic.db

# ── Processing ────────────────────────────────────────────────────────────
FRAME_SKIP=1
MAX_RESOLUTION=1280

# ── Upload Limits ─────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=100

# ── Violation Rules ───────────────────────────────────────────────────────
RED_LIGHT_ENABLED=true
RED_LIGHT_LINE_Y=400
SIGNAL_STATE=GREEN
SPEED_ZONE_ENABLED=true
SPEED_ZONE_DISPLACEMENT_THRESHOLD=80.0
HELMET_ENABLED=false
EVIDENCE_COOLDOWN_SECONDS=3.0

# ── Server ────────────────────────────────────────────────────────────────
HOST=localhost
PORT=8000
DEBUG=true

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
